JOBMATE_DEBUG=true
JOBMATE_DATABASE_URL=postgresql+asyncpg://jobmate:jobmate@localhost:5432/jobmate
JOBMATE_REDIS_URL=redis://localhost:6379/0
JOBMATE_JWT_SECRET_KEY=change-me-in-production
JOBMATE_OPENAI_API_KEY=your-openai-api-key
JOBMATE_OPENAI_MODEL=gpt-4o-mini
# 채용공고 검색은 사람인 공식 오픈 API 만 씁니다(스크래핑 없음).
# 키가 없으면 검색 대신 직접 검색 링크를 안내합니다. 발급: https://oapi.saramin.co.kr
JOBMATE_SARAMIN_API_KEY=your-saramin-api-key
JOBMATE_PUBLIC_DATA_API_KEY=your-public-data-api-key
JOBMATE_YOUTUBE_API_KEY=your-youtube-api-key

# Web
JOBMATE_CORS_ORIGINS=["http://localhost:5173"]
JOBMATE_COOKIE_SECURE=false
JOBMATE_COOKIE_SAMESITE=lax
